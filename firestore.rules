rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validTournament(data) {
      return data.keys().hasAll([
          'name', 'format', 'status', 'organizerUid', 'oversPerInnings',
          'registrationOpen', 'createdAt', 'updatedAt', 'startDate', 'venue'
        ])
        && data.keys().hasOnly([
          'name', 'format', 'status', 'organizerUid', 'oversPerInnings',
          'registrationOpen', 'createdAt', 'updatedAt', 'startDate', 'endDate', 'venue'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.format in ['KNOCKOUT', 'LEAGUE', 'GROUP_KNOCKOUT']
        && data.status in ['REGISTRATION', 'UPCOMING', 'LIVE', 'COMPLETED']
        && data.organizerUid is string
        && data.organizerUid == request.auth.uid
        && data.oversPerInnings is int
        && data.oversPerInnings > 0
        && data.oversPerInnings <= 100
        && data.registrationOpen is bool
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.venue is string
        && data.venue.size() > 0
        && data.venue.size() <= 100
        && (!data.keys().hasAny(['endDate']) || (
          data.endDate is string
          && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.endDate >= data.startDate
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null
        && validTournament(request.resource.data)
        && request.resource.data.status == 'REGISTRATION'
        && request.resource.data.registrationOpen == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(resource.data.organizerUid)
        && validTournament(request.resource.data)
        && request.resource.data.organizerUid == resource.data.organizerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(resource.data.organizerUid);

      match /teams/{teamId} {
        allow read, write: if false;
      }

      match /privateRegistrations/{registrationId} {
        allow read, write: if false;
      }
    }
  }
}
