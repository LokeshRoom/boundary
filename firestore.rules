rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownsTournament(tournamentId) {
      return request.auth != null
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerUid == request.auth.uid;
    }

    function validTournament(data) {
      return data.keys().hasAll([
          'name', 'format', 'status', 'organizerUid', 'oversPerInnings',
          'registrationOpen', 'createdAt', 'updatedAt', 'startDate', 'venue',
          'ballsPerOver', 'powerplayOvers'
        ])
        && data.keys().hasOnly([
          'name', 'format', 'status', 'organizerUid', 'oversPerInnings',
          'registrationOpen', 'createdAt', 'updatedAt', 'startDate', 'endDate', 'venue',
          'ballsPerOver', 'powerplayOvers', 'teamCount'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.format in ['KNOCKOUT', 'LEAGUE', 'GROUP_KNOCKOUT']
        && data.status in ['REGISTRATION', 'UPCOMING', 'LIVE', 'COMPLETED']
        && data.organizerUid is string
        && data.organizerUid == request.auth.uid
        && data.oversPerInnings is int
        && data.oversPerInnings > 0
        && data.oversPerInnings <= 100
        && data.ballsPerOver is int
        && data.ballsPerOver > 0
        && data.ballsPerOver <= 12
        && data.powerplayOvers is int
        && data.powerplayOvers >= 0
        && data.powerplayOvers <= data.oversPerInnings
        && (!data.keys().hasAny(['teamCount']) || (
          data.teamCount is int
          && data.teamCount >= 0
          && data.teamCount <= 1000
        ))
        && data.registrationOpen is bool
        && data.startDate is string
        && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.venue is string
        && data.venue.size() > 0
        && data.venue.size() <= 100
        && (!data.keys().hasAny(['endDate']) || (
          data.endDate is string
          && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && data.endDate >= data.startDate
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTeam(data) {
      return data.keys().hasAll(['name', 'shortName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'shortName', 'status', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.shortName is string
        && data.shortName.size() > 0
        && data.shortName.size() <= 5
        && data.status == 'APPROVED'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validPlayer(data) {
      return data.keys().hasAll(['name', 'jerseyNumber', 'role'])
        && data.keys().hasOnly(['name', 'jerseyNumber', 'role'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.jerseyNumber is int
        && data.jerseyNumber >= 0
        && data.jerseyNumber <= 99
        && data.role in ['BATTER', 'BOWLER', 'ALL_ROUNDER', 'WICKETKEEPER'];
    }

    function validFixture(data, fixtureId) {
      return data.keys().hasAll(['format', 'createdAt', 'updatedAt'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && ((fixtureId in ['knockout', 'league']
          && data.keys().hasAll(['rounds'])
          && data.keys().hasOnly(['format', 'rounds', 'createdAt', 'updatedAt'])
          && data.rounds is list
          && data.rounds.size() > 0
          && ((fixtureId == 'knockout' && data.format == 'KNOCKOUT' && data.rounds.size() <= 7)
            || (fixtureId == 'league' && data.format == 'ROUND_ROBIN' && data.rounds.size() <= 63)))
          || (fixtureId == 'groups'
            && data.keys().hasAll(['groups'])
            && data.keys().hasOnly(['format', 'groups', 'createdAt', 'updatedAt'])
            && data.format == 'GROUP_STAGE'
            && data.groups is list
            && data.groups.size() >= 2
            && data.groups.size() <= 32));
    }

    function validPrivateRegistration(data) {
      return data.keys().hasAll(['captainName', 'captainContact', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['captainName', 'captainContact', 'createdAt', 'updatedAt'])
        && data.captainName is string
        && data.captainName.size() > 0
        && data.captainName.size() <= 80
        && data.captainContact is string
        && data.captainContact.size() >= 5
        && data.captainContact.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function registrationIsOpen(tournamentId) {
      let tournament = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
      return tournament.status == 'REGISTRATION' && tournament.registrationOpen == true;
    }

    function validPendingRegistration(data) {
      return data.keys().hasAll([
          'teamName', 'shortName', 'captainName', 'captainContact', 'submittedAt'
        ])
        && data.keys().hasOnly([
          'teamName', 'shortName', 'captainName', 'captainContact', 'submittedAt'
        ])
        && data.teamName is string
        && data.teamName.size() > 0
        && data.teamName.size() <= 60
        && data.shortName is string
        && data.shortName.size() > 0
        && data.shortName.size() <= 5
        && data.captainName is string
        && data.captainName.size() > 0
        && data.captainName.size() <= 80
        && data.captainContact is string
        && data.captainContact.size() >= 5
        && data.captainContact.size() <= 120
        && data.submittedAt is timestamp
        && data.submittedAt == request.time;
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if request.auth != null
        && validTournament(request.resource.data)
        && request.resource.data.status == 'REGISTRATION'
        && request.resource.data.registrationOpen == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInAs(resource.data.organizerUid)
        && validTournament(request.resource.data)
        && request.resource.data.organizerUid == resource.data.organizerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedInAs(resource.data.organizerUid);

      match /teams/{teamId} {
        allow read: if true;
        allow create: if ownsTournament(tournamentId)
          && validTeam(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsTournament(tournamentId)
          && validTeam(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsTournament(tournamentId);

        match /players/{playerId} {
          allow read: if true;
          allow create, update: if ownsTournament(tournamentId) && validPlayer(request.resource.data);
          allow delete: if ownsTournament(tournamentId);
        }
      }

      match /privateRegistrations/{registrationId} {
        allow read: if ownsTournament(tournamentId);
        allow create: if ownsTournament(tournamentId)
          && existsAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/teams/$(registrationId))
          && validPrivateRegistration(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if ownsTournament(tournamentId)
          && validPrivateRegistration(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsTournament(tournamentId);
      }

      match /pendingRegistrations/{registrationId} {
        allow create: if request.auth != null
          && registrationId == request.auth.uid
          && registrationIsOpen(tournamentId)
          && validPendingRegistration(request.resource.data);
        allow read, update, delete: if ownsTournament(tournamentId);

        match /players/{playerId} {
          allow create: if request.auth != null
            && registrationId == request.auth.uid
            && registrationIsOpen(tournamentId)
            && existsAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/pendingRegistrations/$(registrationId))
            && validPlayer(request.resource.data);
          allow read, update, delete: if ownsTournament(tournamentId);
        }
      }

      match /fixtures/{fixtureId} {
        allow read: if true;
        allow create: if fixtureId in ['knockout', 'league', 'groups']
          && ownsTournament(tournamentId)
          && validFixture(request.resource.data, fixtureId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if fixtureId == 'knockout'
          && ownsTournament(tournamentId)
          && validFixture(request.resource.data, fixtureId)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
        allow delete: if ownsTournament(tournamentId);
      }
    }
  }
}
